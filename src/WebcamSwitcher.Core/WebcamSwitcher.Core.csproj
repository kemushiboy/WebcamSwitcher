<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WebcamSwitcher.Core</AssemblyName>
    <RootNamespace>WebcamSwitcher.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <!-- Diagnostic harness only (tools/MfProbe): lets it drive the reference
         scalar conversion as the byte-identity oracle. Not part of the app. -->
        <InternalsVisibleTo Include="WebcamSwitcher.MfProbe" />
    <InternalsVisibleTo Include="WebcamSwitcher.VcamTest" />
    <InternalsVisibleTo Include="WebcamSwitcher.RoleTest" />
  </ItemGroup>
</Project>
