<Window x:Class="WebcamSwitcher.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebcamSwitcher Settings" Width="900" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="820">
        <StackPanel Margin="16">

            <TextBlock Text="Camera Roles (capture options)" Foreground="White" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Which physical camera feeds which role is set in Camera registration. Capture Auto never assumes MJPEG and prefers a mode that reaches the output frame rate; a 4:3 camera is fitted with the scale mode (Letterbox by default)."/>
            <StackPanel x:Name="CamerasPanel"/>

            <TextBlock Text="Output (all virtual cameras)" Foreground="White" FontWeight="Bold" Margin="0,12,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Width" Foreground="#CCC"/>
                    <ComboBox x:Name="WidthCombo" Width="110" IsEditable="True" AutomationProperties.AutomationId="WidthCombo"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Height" Foreground="#CCC"/>
                    <ComboBox x:Name="HeightCombo" Width="110" IsEditable="True" AutomationProperties.AutomationId="HeightCombo"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="FPS" Foreground="#CCC"/>
                    <ComboBox x:Name="FpsCombo" Width="90" IsEditable="True" AutomationProperties.AutomationId="FpsCombo"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Reconnect" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Retry interval (ms)" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="RetryIntervalBox" Width="70" Margin="0,0,16,0" AutomationProperties.AutomationId="RetryIntervalBox"/>
                <TextBlock Text="Retry count" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="RetryCountBox" Width="60" Margin="0,0,16,0" AutomationProperties.AutomationId="RetryCountBox"/>
                <CheckBox x:Name="RetryForeverBox" Content="Retry forever" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"
                          AutomationProperties.AutomationId="RetryForeverBox"/>
                <TextBlock Text="Startup wait (ms)" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="StartupWaitBox" Width="70" Margin="0,0,16,0" AutomationProperties.AutomationId="StartupWaitBox"/>
                <TextBlock Text="No-signal after (ms)" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="NoSignalBox" Width="60" AutomationProperties.AutomationId="NoSignalBox"/>
            </StackPanel>
            <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="Reconnects only ever target the same device ID. Retry count limits open attempts while the device is present; a device that re-appears always gets a fresh attempt. Startup wait: at launch, devices that have not enumerated yet show CONNECTING (not MISSING) for this long."/>

            <TextBlock Text="Rotate hotkey (switcher)" Foreground="#CCC" Margin="0,0,0,6"/>
            <TextBox x:Name="RotateHotkeyBox" Width="130" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.AutomationId="RotateHotkeyBox"/>

            <TextBlock Text="Common video delay (ms)" Foreground="#CCC" Margin="0,0,0,6"/>
            <TextBox x:Name="CommonDelayBox" Width="90" HorizontalAlignment="Left" Margin="0,0,0,6"
                     AutomationProperties.AutomationId="CommonDelayBox"/>
            <TextBlock Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="Added to every role (0-2000 ms). 0 turns the delay stage off completely (no added latency). Changes take effect immediately; Apply saves them."/>

            <Separator Margin="0,4"/>

            <TextBlock Text="Startup and recovery" Foreground="White" FontWeight="Bold" Margin="0,10,0,6"/>
            <CheckBox x:Name="StartWithWindowsBox" Content="Start at Windows sign-in" Foreground="White" Margin="0,0,0,4"/>
            <CheckBox x:Name="StartMinimizedBox" Content="Start minimized to the tray" Foreground="White" Margin="0,0,0,4"/>
            <CheckBox x:Name="CaptureEnabledBox" Content="Start camera capture automatically" Foreground="White" Margin="0,0,0,4"
                      AutomationProperties.AutomationId="CaptureEnabledBox"/>
            <CheckBox x:Name="AutoRegisterBox" Content="Register the enabled role virtual cameras automatically" Foreground="White" Margin="0,0,0,4"
                      AutomationProperties.AutomationId="AutoRegisterBox"/>
            <CheckBox x:Name="RestartOnCrashBox" Content="Restart automatically after a crash or hang (Windows restart manager)" Foreground="White" Margin="0,0,0,4"
                      AutomationProperties.AutomationId="RestartOnCrashBox"/>
            <CheckBox x:Name="SwitcherBox" Content="Switcher virtual camera (&quot;WebcamSwitcher Virtual Camera&quot;, hotkey-switched; off by default)" Foreground="White" Margin="0,0,0,4"
                      AutomationProperties.AutomationId="SwitcherBox"/>
            <CheckBox x:Name="PreferSmooth30FpsBox"
                      Content="Prefer smooth 30 fps (caps exposure at 1/30 s; may darken the image in low light)"
                      Foreground="White" Margin="0,0,0,8"
                      AutomationProperties.AutomationId="PreferSmooth30FpsBox"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Performance log every (s, 0 = off)" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="PerfIntervalBox" Width="60" Margin="0,0,16,0"/>
                <TextBlock Text="Log files kept" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="LogFilesBox" Width="50" Margin="0,0,16,0"/>
                <TextBlock Text="MB per log file" Foreground="#CCC" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="LogSizeBox" Width="50"/>
            </StackPanel>

            <TextBlock x:Name="NoteText" Foreground="#888" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="14,6" Margin="0,0,8,0" Background="#333" Foreground="White" Click="Cancel_Click" AutomationProperties.AutomationId="CancelButton"/>
                <Button Content="Apply" Padding="14,6" Background="#2D7DD2" Foreground="White" Click="Apply_Click" AutomationProperties.AutomationId="ApplyButton"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
