<Window x:Class="WebcamSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WebcamSwitcher - Camera Roles" Width="1060" Height="760"
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">
    <Window.Resources>
        <!-- Tooltips: quiet, readable, one sentence. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="17"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Per-tile virtual camera chip: a small state pill in the bottom
             corner, away from the top-left camera label. -->
        <DataTemplate x:Key="VcamChipContent">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#8A8A8A"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VcamRunning}" Value="True">
                                    <Setter Property="Fill" Value="#59C46B"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding VcamBusy}" Value="True">
                                    <Setter Property="Fill" Value="#FFB300"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding VcamFailed}" Value="True">
                                    <Setter Property="Fill" Value="#E05252"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding VcamText}" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ChipFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-2" CornerRadius="12"
                                BorderBrush="#F5F5F5" BorderThickness="1"
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VcamChipStyle" TargetType="Button">
            <!-- Shown only when the keyboard is driving the UI. -->
            <Setter Property="FocusVisualStyle" Value="{StaticResource ChipFocusVisual}"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Background" Value="#E61C1C1C"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <!-- Content is the PreviewVm so the chip template can read its state. -->
            <Setter Property="Content" Value="{Binding}"/>
            <Setter Property="ToolTip" Value="{Binding VcamHint}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding VcamAutomationName}"/>
            <Setter Property="ContentTemplate" Value="{StaticResource VcamChipContent}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Pill"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Softer hover instead of a hard colour jump. -->
                            <Border x:Name="Hover" CornerRadius="10" Background="#1AFFFFFF"
                                    Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="#30000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Hover" Property="Opacity" Value="0"/>
                                <Setter TargetName="Pill" Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding VcamRunning}" Value="True">
                    <Setter Property="Background" Value="#E6182E1F"/>
                    <Setter Property="BorderBrush" Value="#4CAF50"/>
                    <Setter Property="Foreground" Value="#E4F7E8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VcamBusy}" Value="True">
                    <Setter Property="Background" Value="#E62E2718"/>
                    <Setter Property="BorderBrush" Value="#FFB300"/>
                    <Setter Property="Foreground" Value="#FFE0A3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding VcamFailed}" Value="True">
                    <Setter Property="Background" Value="#E62E1A1A"/>
                    <Setter Property="BorderBrush" Value="#E05252"/>
                    <Setter Property="Foreground" Value="#FFC2C2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ScrollViewer x:Name="PreviewScroller" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Previews">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="330" Margin="4" CornerRadius="6" BorderThickness="2"
                                Background="#111" Cursor="Hand" MouseLeftButtonDown="Preview_Click" Tag="{Binding Index}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#3A3A3A"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                            <Grid Height="186">
                                <Image Source="{Binding Bitmap}" Stretch="Uniform"/>
                                <TextBlock Text="{Binding Label}" Foreground="White" Background="#AA000000" FontWeight="Bold"
                                           Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                        CornerRadius="3" Padding="6,2" Background="{Binding StatusColor}">
                                    <TextBlock Text="{Binding StatusText}" Foreground="Black" FontSize="11" FontWeight="Bold"/>
                                </Border>

                                <!-- Clicking toggles only this camera's virtual camera.
                                     The handler marks the click handled so the tile is
                                     not also selected; this control is the only
                                     interactive element inside the tile. -->
                                <Button Style="{StaticResource VcamChipStyle}"
                                        IsEnabled="{Binding VcamClickable}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,8,8"
                                        Click="VcamChip_Click"
                                        AutomationProperties.AutomationId="{Binding VcamAutomationId}"/>
                            </Grid>
                            <TextBlock Text="{Binding Stats}" Foreground="#BDBDBD" FontSize="10.5" FontFamily="Consolas"
                                       Margin="6,4,6,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Detail}" Foreground="#E0C080" FontSize="10.5"
                                       Margin="6,2,6,6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="PreviewsOffText" Visibility="Collapsed"
                       Text="Previews are off. Capture and the virtual cameras are still running."
                       Foreground="#888" FontSize="14" TextWrapping="Wrap" MaxWidth="420"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Foreground="#CCC" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="VcamToggle" Content="Virtual Camera: OFF" Padding="10,6" Click="VcamToggle_Click"
                    Background="#333" Foreground="White" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="VcamToggle"
                    ToolTip="The switcher camera only. Each camera's own passthrough camera has its switch on its preview tile."
                    ToolTipService.InitialShowDelay="400"/>
            <Button x:Name="CaptureToggle" Content="Cameras: ON" Padding="10,6" Click="CaptureToggle_Click"
                    Background="#333" Foreground="White" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="CaptureToggle"/>
            <Button x:Name="PreviewsToggle" Content="Previews: ON" Padding="10,6" Click="PreviewsToggle_Click"
                    Background="#333" Foreground="White" Margin="0,0,8,0"
                    AutomationProperties.AutomationId="PreviewsToggle"/>
            <Button Content="Register cameras" Padding="14,6" Click="Register_Click" Background="#2D7DD2" Foreground="White"
                    Margin="0,0,8,0" AutomationProperties.AutomationId="RegisterButton"/>
            <Button Content="Settings" Padding="14,6" Click="Settings_Click" Background="#333" Foreground="White"
                    Margin="0,0,8,0" AutomationProperties.AutomationId="SettingsButton"/>
            <Button Content="Open log" Padding="14,6" Click="OpenLog_Click" Background="#333" Foreground="White"
                    AutomationProperties.AutomationId="OpenLogButton"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
